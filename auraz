];
const TODAY_DAY = "jeudi";
const MATCHS = [
  { id:"m1", a:{user:"karim", photo:"d", votes:142}, b:{user:"lena",  photo:"c", votes:98}  },
  { id:"m2", a:{user:"sofia", photo:"e", votes:201}, b:{user:"neo",   photo:"b", votes:87}  },
  { id:"m3", a:{user:"vsk",   photo:"c", votes:54},  b:{user:"diego", photo:"c", votes:121} },
  { id:"m4", a:{user:"anon",  photo:"b", votes:33},  b:{user:"mira",  photo:"d", votes:67}  },
