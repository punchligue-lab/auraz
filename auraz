function App(){
  const [route,setRoute]=useState("splash");const [tab,setTab]=useState("feed");const [overlay,setOverlay]=useState(null);const [activePost,setActivePost]=useState(null);const [credits,setCredits]=useState(32);const [plan,setPlan]=useState("free");const [toast,setToast]=useState(null);
  function showToast(msg){ setToast(msg); setTimeout(()=>setToast(null),1900); }
  function spend(action){ const c=COST[action]??0; if(plan==="plus"||c===0)return true; if(credits<c){ setOverlay("paywall"); return false; } setCredits(v=>v-c); showToast(`-${c} crédit${c>1?"s":""}`); return true; }
  function goTab(t){ if(t==="create"){ setOverlay("create"); return; } setTab(t); setOverlay(null); }
  function renderMain(){
    if(route==="splash")  return <Splash onDone={()=>setRoute("onboard")}/>;
    if(route==="onboard") return <Onboarding onFinish={()=>{setRoute("app");setTab("feed");}}/>;
    let main;
    if(tab==="feed")    main=<Feed onOpen={p=>{setActivePost(p);setOverlay("guess");}} onOpenNotifs={()=>setOverlay("notifs")}/>;
    else if(tab==="mine")    main=<MyPosts onBack={()=>setTab("feed")}/>;
    else if(tab==="matchs")  main=<Matchs/>;
    else if(tab==="profile") main=<Profile credits={credits} plan={plan} onOpenSettings={()=>setOverlay("settings")} onOpenPaywall={()=>setOverlay("paywall")}/>;
    else main=<Feed onOpen={p=>{setActivePost(p);setOverlay("guess");}} onOpenNotifs={()=>setOverlay("notifs")}/>;
    return <div style={{width:"100%",height:"100%",position:"relative"}}>{main}<TabBar current={tab} onChange={goTab}/></div>;
  }
  function renderOverlay(){
    if(overlay==="notifs")   return <NotifDrawer onClose={()=>setOverlay(null)}/>;
    if(overlay==="settings") return <Settings onBack={()=>setOverlay(null)}/>;
    if(overlay==="create")   return <Create spend={spend} onCancel={()=>setOverlay(null)} onPosted={()=>{setOverlay(null);setTab("mine");}}/>;
    if(overlay==="guess"&&activePost) return <GuessScreen post={activePost} onBack={()=>setOverlay(null)} onSent={()=>setOverlay(null)} spend={spend}/>;
    if(overlay==="paywall")  return <Paywall onClose={()=>setOverlay(null)} onBuy={p=>{setCredits(c=>c+p.credits);setOverlay(null);showToast(`+${p.credits} crédits`);}} onSubscribe={()=>{setPlan("plus");setOverlay(null);showToast("AURAZ+ activé · crédits illimités");}}/>;
    return null;
  }
