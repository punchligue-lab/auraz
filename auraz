  const items=[{l:"Compte",v:"@diego"},{l:"Notifications",v:"Activées"},{l:"Langue",v:"Français"},{l:"Confidentialité",v:""},{l:"Aide",v:""},{l:"CGU",v:""},{l:"Se déconnecter",v:"",danger:true}];
