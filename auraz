Size:28,minWidth:80}}>{p.credits}<span style={{fontSize:14,color:"#666",marginLeft:4}}>cr</span></div><div style={{flex:1}}>{p.tag&&<div className="caps" style={{fontSize:9,color:"#000",marginBottom:2}}>● {p.tag}</div>}<div className="mono" style={{fontSize:11,color:"#666"}}>paiement unique</div></div><div className="display" style={{fontSize:20,fontWeight:800}}>{p.price}</div></button>)}</div><button onClick={onClose} className="tap" style={{display:"block",margin:"16px auto 0",background:"none",border:"none",color:"#8A8A8A",fontWeight:600,fontSize:13,cursor:"pointer"}}>Plus tard</button></div></div>;
