function Photo({ tone="c" }){ return <div className={`photo-ph ${tone}`} style={{width:"100%",height:"100%",borderRadius:"inherit"}}/>; }
function Header({ title, onBack, right }){
  return <div style={{padding:"6px 20px 12px",display:"flex",alignItems:"center",justifyContent:"space-between",flexShrink:0}}>{onBack?<button className="tap" onClick={onBack} style={{background:"none",border:"none",fontSize:26,cursor:"pointer",fontWeight:700,padding:"2px 8px 2px 0",lineHeight:1,color:"#000"}}>‹</button>:<div style={{width:24}}/>}<div className="display" style={{fontSize:18}}>{title}</div><div style={{minWidth:24,textAlign:"right"}}>{right||null}</div></div>;
}
function TabBar({ current, onChange }){
  const tabs=[{id:"feed",label:"Devine"},{id:"matchs",label:"Matchs"},{id:"create",label:"+"},{id:"mine",label:"Mes posts"},{id:"profile",label:"Profil"}];
  return <div style={{position:"absolute",left:0,right:0,bottom:0,paddingBottom:28,paddingTop:12,background:"linear-gradient(180deg,rgba(255,255,255,0),#fff 30%)",display:"flex",justifyContent:"space-around",alignItems:"center",zIndex:50}}>{tabs.map(t=>{const active=current===t.id;if(t.id==="create") return <button key={t.id} className="btn btn-ink tap" onClick={()=>onChange(t.id)} style={{width:52,height:52,borderRadius:"50%",fontSize:26,display:"flex",alignItems:"center",justifyContent:"center",lineHeight:1}}>+</button>;return <button key={t.id} onClick={()=>onChange(t.id)} style={{background:"none",border:"none",cursor:"pointer",display:"flex",flexDirection:"column",alignItems:"center",gap:2,padding:"4px 8px",color:active?"#000":"#9c9c9c",fontWeight:active?800:600,fontSize:11,letterSpacing:".04em",textTransform:"uppercase"}}><span style={{fontSize:6,opacity:active?1:0}}>●</span>{t.label}</button>;})}</div>;
}
function CreditHUD({ credits, plan, onClick }){
  const isPlus=plan==="plus";
  return <button onClick={onClick} className="tap" style={{position:"absolute",top:8,right:14,zIndex:55,display:"flex",alignItems:"center",gap:5,padding:"5px 10px 5px 8px",borderRadius:99,background:isPlus?"#000":"#fff",color:isPlus?"#fff":"#000",border:isPlus?"none":"1.5px solid #000",fontFamily:"'JetBrains Mono',monospace",fontWeight:700,fontSize:12,cursor:"pointer"}}><span style={{fontSize:10}}>◆</span><span>{isPlus?"∞":credits}</span><span style={{fontSize:9,opacity:.65,letterSpacing:".05em"}}>CR</span></button>;
}
function Splash({ onDone }){
  useEffect(()=>{ const t=setTimeout(onDone,1400); return ()=>clearTimeout(t); },[]);
  return <div onClick={onDone} style={{width:"100%",height:"100%",background:"#000",color:"#fff",display:"flex",alignItems:"center",justifyContent:"center",cursor:"pointer"}}><div className="display" style={{fontSize:72,letterSpacing:"-.04em"}}>AURAZ</div></div>;
}
function Onboarding({ onFinish }){
  const [s,setS]=useState(0);const total=3;
  const slides=[{kicker:"Le concept",h:"Poste une photo.\nLes autres devinent.",body:"Pas d'IA. Juste l'instinct des autres. Ta photo est publique, c'est le jeu."},{kicker:"Le jeu",h:"« Tu es en fac\nde médecine. »",body:"Tu valides vrai, faux, ou presque. Plus c'est dur à deviner, plus ça rapporte de points."},{kicker:"Les matchs",h:"Du lundi\nau samedi.",body:"Vote pour la meilleure photo en duel. Les meilleurs s'affrontent en finale le dimanche."}];
  const cur=slides[s];
  return <div style={{width:"100%",height:"100%",background:"#fff",display:"flex",flexDirection:"column",padding:"22px 24px 30px"}}><div className="pb" style={{height:3,marginBottom:32}}><i style={{width:`${((s+1)/total)*100}%`}}/></div><div style={{flex:1,display:"flex",flexDirection:"column",justifyContent:"center"}}><div className="caps" style={{fontSize:11,marginBottom:18}}>● {cur.kicker}</div><h1 className="display" style={{fontSize:52,margin:0,lineHeight:.95,whiteSpace:"pre-line"}}>{cur.h}</h1><p style={{color:"#5a5a5a",fontSize:15,marginTop:22,lineHeight:1.55,maxWidth:300}}>{cur.body}</p></div><div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}><button onClick={onFinish} className="tap" style={{background:"none",border:"none",color:"#8A8A8A",fontWeight:600,fontSize:14,cursor:"pointer"}}>Passer</button><button className="btn btn-ink tap" onClick={()=>s<total-1?setS(s+1):onFinish()} style={{padding:"14px 24px",fontSize:14,letterSpacing:".04em"}}>{s===total-1?"Commencer ●":"Suivant ›"}</button></div></div>;
}
function Feed({ onOpen, onOpenNotifs }){
  const [idx,setIdx]=useState(0);const post=POSTS[idx%POSTS.length];
  return <div style={{width:"100%",height:"100%",background:"#fff",display:"flex",flexDirection:"column"}}><div style={{padding:"6px 20px 4px",display:"flex",alignItems:"center",justifyContent:"space-between",flexShrink:0}}><div className="display" style={{fontSize:22,letterSpacing:"-.03em"}}>AURAZ</div><div style={{display:"flex",gap:8,alignItems:"center",marginRight:72}}><span className="pill" style={{background:"#F4F4F4",color:"#000"}}>● {ME.points} pts</span><button className="tap" onClick={onOpenNotifs} style={{width:34,height:34,borderRadius:"50%",border:"1.5px solid #000",background:"#fff",cursor:"pointer",fontSize:11,fontWeight:800,display:"flex",alignItems:"center",justifyContent:"center"}}>4</button></div></div><div style={{padding:"4px 20px 8px",display:"flex",gap:6,alignItems:"center",flexShrink:0}}>{["fresh","amis","peu vus"].map((l,i)=><span key={l} className="pill tap" style={{background:i===0?"#000":"#F4F4F4",color:i===0?"#fff":"#666",cursor:"pointer"}}>{l}</span>)}<div style={{flex:1}}/><span className="mono" style={{fontSize:11,color:"#8A8A8A"}}>{idx+1}/{POSTS.length}</span></div><div className="scroll" style={{flex:1,overflowY:"auto",padding:"6px 20px 110px",display:"flex",flexDirection:"column",alignItems:"center"}}><div className="domino" key={post.id} style={{width:"100%",maxWidth:360}}><div onClick={()=>onOpen(post)} className="tap" style={{aspectRatio:"4/5",borderRadius:24,overflow:"hidden",position:"relative",cursor:"pointer",border:"1px solid #E6E6E6"}}><Photo tone={post.photo}/><div style={{position:"absolute",top:12,left:12,display:"flex",gap:6}}>{post.anonymous&&<span className="pill" style={{background:"rgba(0,0,0,.55)",color:"#fff"}}>anon</span>}<span className="pill" style={{background:"rgba(255,255,255,.85)",color:"#000"}}>{post.time}</span></div><div style={{position:"absolute",left:0,right:0,bottom:0,padding:14,background:"linear-gradient(180deg,transparent,rgba(0,0,0,.72))",color:"#fff"}}><div className="caps" style={{fontSize:10,opacity:.85}}>{post.anonymous?"anonyme":"@"+post.user}</div><div style={{fontWeight:700,fontSize:14,marginTop:2}}>{post.guesses} devinettes · {post.points} pts</div></div></div><div style={{display:"flex",gap:10,marginTop:14}}><button className="btn btn-paper tap" onClick={()=>setIdx(i=>(i+1)%POSTS.length)} style={{flex:1,padding:"14px",fontSize:13}}>PASSER</button><button className="btn btn-ink tap" onClick={()=>onOpen(post)} style={{flex:2,padding:"14px",fontSize:13}}>DEVINER ●</button></div></div></div></div>;
}
function GuessScreen({ post, onBack, onSent, spend }){
  const [text,setText]=useState("");const [sent,setSent]=useState(null);const sugg=SUGGESTIONS.slice(0,8);
  function sendGuess(val){ if(!val||sent)return; if(spend&&!spend("guess"))return; setSent(val); setTimeout(()=>onSent&&onSent(val),1400); }
  return <div style={{width:"100%",height:"100%",background:"#fff",display:"flex",flexDirection:"column"}}><Header title="Deviner" onBack={onBack} right={<span className="mono" style={{fontSize:11,color:"#8A8A8A"}}>{post.time}</span>}/><div className="scroll" style={{flex:1,overflowY:"auto",padding:"0 20px 110px"}}><div style={{aspectRatio:"4/5",borderRadius:24,overflow:"hidden",border:"1px solid #E6E6E6",marginBottom:12}}><Photo tone={post.photo}/></div><div className="caps" style={{fontSize:10,color:"#8A8A8A"}}>● {post.anonymous?"anonyme":"@"+post.user}</div><h2 className="display" style={{fontSize:30,margin:"6px 0 14px",lineHeight:1}}>Devine quelque<br/>chose sur {post.anonymous?"cette personne":"@"+post.user}.</h2>{!sent&&<div style={{display:"flex",gap:8,padding:"10px 14px",border:"1.5px solid #000",borderRadius:14,marginBottom:14,background:"#fff"}}><input value={text} onChange={e=>setText(e.target.value)} placeholder="ex: aime le foot, a un chat…" onKeyDown={e=>e.key==="Enter"&&sendGuess(text)} style={{flex:1,border:"none",outline:"none",fontSize:15,fontWeight:600,background:"transparent"}}/><button className="btn btn-ink tap" disabled={!text} onClick={()=>sendGuess(text)} style={{padding:"8px 16px",fontSize:13,opacity:text?1:.35}}>ENVOYER</button></div>}<div className="caps" style={{fontSize:10,color:"#8A8A8A",marginBottom:8}}>● ou choisis</div><div style={{display:"flex",flexWrap:"wrap",gap:8}}>{sugg.map(s=><button key={s} className="chip" onClick={()=>sendGuess(s)} style={{background:sent===s?"#000":"#F4F4F4",color:sent===s?"#fff":"#000"}}>{s}</button>)}</div>{sent&&<div className="domino" style={{marginTop:18,padding:"14px 16px",background:"#000",color:"#fff",borderRadius:18}}><div className="caps" style={{fontSize:10,opacity:.7,marginBottom:4}}>● devinette envoyée</div><div style={{fontWeight:700,fontSize:15}}>« {sent} »</div><div style={{color:"#aaa",fontSize:12,marginTop:6}}>En attente de validation. Tu sauras quand le posteur tranche.</div></div>}</div></div>;
}
function MyPosts({ onBack }){
  const [guesses,setGuesses]=useState(MY_GUESSES_INIT);const [diffPending,setDiffPending]=useState({});
  function handleState(id,state){ setGuesses(g=>g.map(x=>x.id===id?{...x,state,diff:null}:x)); if(state==="vrai"||state==="presque") setDiffPending(p=>({...p,[id]:true})); }
  function handleDiff(id,diff){ setGuesses(g=>g.map(x=>x.id===id?{...x,diff}:x)); setDiffPending(p=>{const n={...p};delete n[id];return n;}); }
  const counts={vrai:guesses.filter(g=>g.state==="vrai").length,presque:guesses.filter(g=>g.state==="presque").length,faux:guesses.filter(g=>g.state==="faux").length};
  const ptsGiven=guesses.reduce((acc,g)=>{ if(!g.diff||!g.state)return acc; const base=DIFF[g.diff].pts; return acc+(g.state==="presque"?Math.ceil(base/2):base); },0);
  return <div style={{width:"100%",height:"100%",background:"#fff",display:"flex",flexDirection:"column"}}><Header title="Mes posts" onBack={onBack}/><div className="scroll" style={{flex:1,overflowY:"auto",padding:"0 20px 110px"}}><div style={{display:"flex",gap:14,alignItems:"center",marginBottom:14}}><div style={{width:74,height:90,borderRadius:14,overflow:"hidden",flexShrink:0}}><Photo tone="c"/></div><div style={{flex:1}}><div className="caps" style={{fontSize:10,color:"#8A8A8A"}}>● il y a 35min · public</div><div className="display" style={{fontSize:22,marginTop:2}}>{guesses.length} devinettes</div><div className="mono" style={{fontSize:12,color:"#666",marginTop:4}}>✓ {counts.vrai} · ~ {counts.presque} · ✗ {counts.faux} · {ptsGiven} pts donnés</div></div></div><div style={{padding:"10px 12px",background:"#F4F4F4",borderRadius:12,fontSize:12,color:"#444",marginBottom:12,lineHeight:1.5}}>● Quand c'est vrai, dis si c'était <strong>facile</strong>, <strong>moyen</strong>, <strong>difficile</strong> ou <strong>insane</strong>. Plus c'est dur → plus de points.</div><div style={{display:"grid",gap:10}}>{guesses.map((g,i)=>{ const showDiff=diffPending[g.id]; const finalPts=g.diff?(g.state==="presque"?Math.ceil(DIFF[g.diff].pts/2):DIFF[g.diff].pts):null; return <div key={g.id} className="domino" style={{animationDelay:`${i*50}ms`,padding:"12px 14px",border:"1px solid #E6E6E6",borderRadius:16,background:"#fff"}}><div style={{display:"flex",alignItems:"flex-start",gap:10,marginBottom:showDiff?10:g.state?8:10}}><div style={{flex:1}}><div className="caps" style={{fontSize:9,color:"#8A8A8A"}}>@{g.from}</div><div style={{fontWeight:700,fontSize:14,marginTop:2}}>« {g.text} »</div></div>{finalPts!=null&&<span className="pill" style={{background:"#000",color:"#fff",flexShrink:0}}>+{finalPts}pts</span>}</div>{!g.state&&!showDiff&&<div style={{display:"flex",gap:6}}>{[{s:"vrai",label:"VRAI ✓",bg:"#000",col:"#fff"},{s:"presque",label:"PRESQUE ~",bg:"#F4F4F4",col:"#000"},{s:"faux",label:"FAUX ✗",bg:"#F4F4F4",col:"#8A8A8A"}].map(b=><button key={b.s} className="btn tap" onClick={()=>handleState(g.id,b.s)} style={{flex:1,padding:"10px 6px",fontSize:11,letterSpacing:".04em",background:b.bg,color:b.col,border:b.bg==="#F4F4F4"?"1px solid #E6E6E6":"none"}}>{b.label}</button>)}</div>}{showDiff&&<div className="fade"><div className="caps" style={{fontSize:10,color:"#8A8A8A",marginBottom:8}}>● C'était…</div><div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:6}}>{DIFF_KEYS.map(k=>{ const d=DIFF[k]; const pts=g.state==="presque"?Math.ceil(d.pts/2):d.pts; return <button key={k} className="tap" onClick={()=>handleDiff(g.id,k)} style={{padding:"10px 8px",borderRadius:12,border:"1px solid #E6E6E6",background:"#fff",cursor:"pointer",textAlign:"left"}}><div style={{fontWeight:800,fontSize:12,letterSpacing:".04em"}}>{d.label}</div><div className="mono" style={{fontSize:10,color:"#8A8A8A",marginTop:2}}>+{pts} pts</div><div style={{fontSize:10,color:"#666",marginTop:2}}>{d.desc}</div></button>; })}</div></div>}{g.state&&!showDiff&&<div style={{display:"flex",alignItems:"center",gap:8}}><span className="pill" style={{background:g.state==="vrai"?"#000":"#F4F4F4",color:g.state==="vrai"?"#fff":"#8A8A8A",border:"1px solid #E6E6E6"}}>{g.state==="vrai"?"✓ Vrai":g.state==="presque"?"~ Presque":"✗ Faux"}</span>{g.diff&&<span style={{fontSize:12,color:"#666"}}>{DIFF[g.diff].label}</span>}</div>}</div>; })}</div></div></div>;
}
function Matchs(){
  const [idx,setIdx]=useState(0);const [voted,setVoted]=useState({});const [tab,setTab]=useState("duel");const total=MATCHS.length;const m=MATCHS[Math.min(idx,total-1)];
  function vote(side){ if(!m||voted[m.id])return; setVoted(v=>({...v,[m.id]:side})); setTimeout(()=>setIdx(i=>Math.min(i+1,total-1)),700); }
  const myVote=voted[m?.id];
  function pct(side){ const va=m.a.votes+(myVote==="a"?1:0),vb=m.b.votes+(myVote==="b"?1:0),tot=va+vb; if(!tot)return 50; return side==="a"?Math.round(va/tot*100):Math.round(vb/tot*100); }
  const totalVotes=m?m.a.votes+m.b.votes+(myVote?1:0):0;
  return <div style={{width:"100%",height:"100%",background:"#fff",display:"flex",flexDirection:"column"}}><div style={{padding:"6px 20px 4px",display:"flex",alignItems:"center",justifyContent:"space-between",flexShrink:0}}><div className="display" style={{fontSize:22,letterSpacing:"-.03em"}}>Matchs</div><span className="pill" style={{background:"#000",color:"#fff"}}>{TODAY_DAY} · jour 4/6</span></div><div style={{padding:"4px 20px 6px",display:"flex",gap:6,flexShrink:0}}>{[{id:"duel",label:"Vote du jour"},{id:"finale",label:"Finale dimanche"}].map(t=><button key={t.id} onClick={()=>setTab(t.id)} className="pill tap" style={{background:tab===t.id?"#000":"#F4F4F4",color:tab===t.id?"#fff":"#666",border:"none",cursor:"pointer",padding:"6px 12px",fontSize:11}}>{t.label}</button>)}{tab==="duel"&&<span className="mono" style={{fontSize:11,color:"#8A8A8A",alignSelf:"center",marginLeft:"auto"}}>{Math.min(idx+1,total)}/{total}</span>}</div>{tab==="duel"?<div className="scroll" style={{flex:1,overflowY:"auto",padding:"4px 20px 110px"}}><div className="display" style={{fontSize:28,lineHeight:1,marginBottom:4}}>Qui tu préfères ?</div><div style={{color:"#8A8A8A",fontSize:13,marginBottom:14}}>Lundi → samedi. Les meilleurs vont en finale dimanche.</div>{m&&<div className="domino" key={m.id} style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,position:"relative"}}>{["a","b"].map(side=>{ const ph=m[side],chosen=myVote===side,dimmed=myVote&&!chosen; return <div key={side} onClick={()=>vote(side)} className="tap" style={{cursor:myVote?"default":"pointer",position:"relative",borderRadius:18,overflow:"hidden",border:chosen?"3px solid #000":"1px solid #E6E6E6",opacity:dimmed?.5:1,transition:"opacity 300ms"}}><div style={{aspectRatio:"3/4"}}><Photo tone={ph.photo}/></div><div style={{position:"absolute",left:0,right:0,bottom:0,padding:"10px 12px",background:"linear-gradient(180deg,transparent,rgba(0,0,0,.85))",color:"#fff"}}><div className="caps" style={{fontSize:9,opacity:.85}}>@{ph.user}</div>{myVote&&<div className="mono" style={{fontSize:20,fontWeight:800,marginTop:2}}>{pct(side)}%</div>}</div>{chosen&&<div style={{position:"absolute",top:10,right:10,background:"#000",color:"#fff",borderRadius:"50%",width:28,height:28,display:"flex",alignItems:"center",justifyContent:"center",fontWeight:700,fontSize:14}}>✓</div>}</div>; })}{!myVote&&<div style={{position:"absolute",top:"50%",left:"50%",transform:"translate(-50%,-50%)",width:44,height:44,borderRadius:"50%",background:"#000",color:"#fff",display:"flex",alignItems:"center",justifyContent:"center",fontWeight:800,fontSize:12,letterSpacing:".04em",boxShadow:"0 0 0 5px #fff",pointerEvents:"none"}}>VS</div>}</div>}{myVote&&<div className="domino" style={{marginTop:14,padding:"12px 14px",background:"#F4F4F4",borderRadius:14,display:"flex",alignItems:"center",gap:10}}><div className="mono" style={{fontSize:11,color:"#666",flex:1}}>{totalVotes} votes · +1 pt pour @{m[myVote].user}</div><button className="btn btn-ink tap" onClick={()=>setIdx(i=>Math.min(i+1,total-1))} style={{padding:"8px 14px",fontSize:11}}>SUIVANT ›</button></div>}<div style={{marginTop:18,padding:"14px 16px",border:"1px solid #E6E6E6",borderRadius:16}}><div className="caps" style={{fontSize:10,color:"#8A8A8A",marginBottom:6}}>● comment ça marche</div><div style={{fontSize:13,lineHeight:1.55,color:"#333"}}>Du <strong>lundi au samedi</strong>, vote dans les duels. Chaque vote reçu rapporte 1 pt à la photo. Les <strong>4 meilleures</strong> s'affrontent en finale le <strong>dimanche</strong>.</div></div></div>:<div className="scroll" style={{flex:1,overflowY:"auto",padding:"4px 20px 110px"}}><div style={{padding:"14px 16px",borderRadius:18,background:"#000",color:"#fff",marginBottom:14}}><div className="caps" style={{fontSize:10,opacity:.7}}>● finale</div><div className="display" style={{fontSize:32,lineHeight:1,marginTop:4}}>Dimanche 20h.</div><div style={{color:"#bbb",fontSize:13,marginTop:8,lineHeight:1.5}}>4 photos. 1 victoire. Le gagnant prend toute la cagnotte de la semaine : <strong style={{color:"#fff"}}>500 pts</strong>.</div><div className="mono" style={{fontSize:11,opacity:.6,marginTop:10}}>Début dans 2j 18h 22m</div></div><div className="caps" style={{fontSize:10,color:"#8A8A8A",marginBottom:8}}>● top 4 actuel</div><div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10}}>{FINALISTS.map((f,i)=><div key={f.user} className="domino" style={{animationDelay:`${i*60}ms`,borderRadius:16,overflow:"hidden",border:"1px solid #E6E6E6"}}><div style={{aspectRatio:"3/4",position:"relative"}}><Photo tone={f.photo}/><div style={{position:"absolute",top:8,left:8,background:"#000",color:"#fff",fontSize:11,fontWeight:800,borderRadius:"50%",width:24,height:24,display:"flex",alignItems:"center",justifyContent:"center"}}>{i+1}</div></div><div style={{padding:"8px 10px"}}><div className="caps" style={{fontSize:10,color:"#8A8A8A"}}>@{f.user}</div><div className="mono" style={{fontSize:13,fontWeight:700,marginTop:2}}>{f.votes} votes</div></div></div>)}</div></div>}</div>;
}
function Create({ onCancel, onPosted, spend }){
  const [tone,setTone]=useState("c");const [anon,setAnon]=useState(false);const [posted,setPosted]=useState(false);
