<style>
  :root{ --paper:#FFFFFF; --ink:#000000; --line:#E6E6E6; --mute:#8A8A8A; --soft:#F4F4F4; }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:#111;font-family:Inter,sans-serif;color:#000;-webkit-font-smoothing:antialiased;}
  body{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px 12px;}
  .display{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;letter-spacing:-0.03em;line-height:1;}
  .mono{font-family:'JetBrains Mono',monospace;font-feature-settings:"tnum" 1;}
  .caps{text-transform:uppercase;letter-spacing:.08em;font-weight:700;}
  .scroll::-webkit-scrollbar{width:0;height:0}.scroll{scrollbar-width:none}
  .btn{appearance:none;border:none;cursor:pointer;border-radius:999px;font-family:inherit;font-weight:700;transition:transform 140ms cubic-bezier(.2,1.4,.3,1),background 200ms,opacity 200ms;}
  .btn:active{transform:scale(.97)}
  .btn-ink{background:#000;color:#fff}
  .btn-paper{background:#fff;color:#000;border:1.5px solid #000}
  .btn-soft{background:#F4F4F4;color:#000}
  .tap{transition:transform 160ms cubic-bezier(.2,1.4,.3,1)} .tap:active{transform:scale(.98)}
  @keyframes domino{from{transform:translateY(10px);opacity:0}to{transform:none;opacity:1}}
  .domino{animation:domino 480ms cubic-bezier(.2,1.2,.3,1) both}
  @keyframes fadeIn{from{opacity:0}to{opacity:1}}
  .fade{animation:fadeIn 300ms ease both}
  .photo-ph{background:repeating-linear-gradient(135deg,rgba(0,0,0,.03) 0 12px,rgba(0,0,0,0) 12px 24px),linear-gradient(160deg,#ddd,#999);}
  .photo-ph.b{background:repeating-linear-gradient(135deg,rgba(255,255,255,.06) 0 12px,rgba(255,255,255,0) 12px 24px),linear-gradient(160deg,#2a2a2a,#050505);}
  .photo-ph.c{background:repeating-linear-gradient(135deg,rgba(0,0,0,.04) 0 12px,rgba(0,0,0,0) 12px 24px),linear-gradient(160deg,#f0f0f0,#b0b0b0);}
  .photo-ph.d{background:repeating-linear-gradient(135deg,rgba(0,0,0,.04) 0 12px,rgba(0,0,0,0) 12px 24px),linear-gradient(160deg,#cfcfcf,#6a6a6a);}
  .photo-ph.e{background:repeating-linear-gradient(135deg,rgba(255,255,255,.05) 0 12px,rgba(255,255,255,0) 12px 24px),linear-gradient(160deg,#4a4a4a,#1a1a1a);}
  .pb{background:#EEE;border-radius:999px}.pb>i{display:block;height:100%;background:#000;border-radius:999px;transition:width 600ms cubic-bezier(.2,1.2,.3,1)}
  input,textarea{font-family:inherit}
  .chip{display:inline-flex;align-items:center;gap:6px;padding:8px 12px;border-radius:999px;background:#F4F4F4;color:#000;font-size:13px;font-weight:600;border:1px solid #E6E6E6;cursor:pointer;transition:background 180ms,color 180ms;}
  .chip:hover,.chip:active{background:#000;color:#fff}
  .pill{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
</style>
</head>
